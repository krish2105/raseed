{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // scripts/generate.mts runs under `node --experimental-strip-types`, which requires
    // the explicit .ts extension on relative imports. Safe here because noEmit is on.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.mts"]
}
