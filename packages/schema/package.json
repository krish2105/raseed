{
  "name": "@raseed/schema",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./sqlite": {
      "types": "./src/sqlite.ts",
      "default": "./src/sqlite.ts"
    },
    "./pg": {
      "types": "./src/pg.ts",
      "default": "./src/pg.ts"
    },
    "./zod": {
      "types": "./src/zod.ts",
      "default": "./src/zod.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "generate": "node --experimental-strip-types scripts/generate.mts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5"
  }
}
