# pnpm's default symlinked node_modules breaks Metro's resolution of transitive
# workspace dependencies. Hoisted gives pnpm's workspace ergonomics with an npm-shaped tree.
node-linker=hoisted

# NOTE: pnpm 11+ reads ONLY auth and registry settings from .npmrc. The line above is
# authoritative on the pinned pnpm 10.30.3 and becomes inert on an upgrade — which is why
# `nodeLinker: hoisted` is ALSO set in pnpm-workspace.yaml. Keep the two in sync.
