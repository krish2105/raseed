{
  "name": "raseed",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || echo 'prepare: not a git checkout, skipping hooks path'",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "build": "turbo build",
    "dev": "turbo dev",
    "coverage": "vitest run --config vitest.coverage.config.ts --coverage"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-67mh-4wv8-2f99",
        "GHSA-w5hq-g745-h8pq"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.5",
    "prettier": "^3.6.2",
    "turbo": "^2.10.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "op-sqlite": {
    "sqlcipher": true
  }
}
