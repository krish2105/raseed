{
  "expo": {
    "name": "RASEED",
    "slug": "raseed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "raseed",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.krishnamathur.raseed",
      "icon": "./assets/expo.icon",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1419",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
