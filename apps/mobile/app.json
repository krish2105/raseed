{
  "expo": {
    "name": "RASEED",
    "slug": "raseed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "raseed",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.krishnamathur.raseed",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "RASEED uses the camera to photograph receipts. The photo is read on this device and is never uploaded.",
        "NSPhotoLibraryUsageDescription": "RASEED reads receipts you choose from your photos. Reading happens on this device and nothing is uploaded."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1419",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
